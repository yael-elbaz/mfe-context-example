{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "shell/employeeStore": ["../shell/src/store/employeeStore.ts"],
      "shell/personStore":   ["../shell/src/store/personStore.ts"],
      "shell/store":         ["../shell/src/store/appContext.ts"]
    }
  },
  "include": ["src"]
}
